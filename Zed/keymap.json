[
    {
        "context": "Workspace",
        "bindings": {
            "ctrl-alt-v": "workspace::ToggleVimMode"
        }
    },
    {
        "context": "Editor && vim_mode == insert",
        "bindings": {
            "j k": "vim::NormalBefore"
        }
    },
    {
        "context": "Editor && extension == cpp",
        "bindings": {
            "ctrl-alt-n": [
                "task::Spawn",
                {
                    "task_name": "Run C++ File"
                }
            ]
        }
    },
    {
        "context": "Editor && extension == c",
        "bindings": {
            "ctrl-alt-n": [
                "task::Spawn",
                {
                    "task_name": "Run C File"
                }
            ]
        }
    },
    {
        "context": "Editor && extension == py",
        "bindings": {
            "ctrl-alt-n": [
                "task::Spawn",
                {
                    "task_name": "Run Python File"
                }
            ]
        }
    },
    {
        "context": "Editor && jupyter",
        "bindings": {
            "shift-enter": "repl::Run"
        }
    },
    {
        "bindings": {
            "ctrl-shift-enter": "repl::ClearOutputs"
        }
    }, 
    {
      "context": "Editor && mode == full",
      "bindings": {
        "ctrl-shift-enter": "editor::NewlineAbove"
      }
    }, 
      {
        "context": "Workspace",
        "bindings": {
          "ctrl-1": "editor::ToggleFocus"
        }
      }
]