  "CP Macros and Debug": {
    "prefix": "template",
    "body": [
      "",
      "using ll = long long;",
      "using ull = unsigned long long;",
      "using ld = long double;",
      "using pii = pair<int, int>;",
      "using pll = pair<ll, ll>;",
      "using vi = vector<int>;",
      "using vll = vector<ll>;",
      "using vvi = vector<vi>;",
      "using vvll = vector<vll>;",
      "using vpii = vector<pii>;",
      "using vpll = vector<pll>;",
      "",
      "#define pb push_back",
      "#define eb emplace_back",
      "#define ff first",
      "#define ss second",
      "#define all(x) (x).begin(), (x).end()",
      "#define rall(x) (x).rbegin(), (x).rend()",
      "#define sz(x) static_cast<int>((x).size())",
      "#define lb(x, value) lower_bound(all(x), value)",
      "#define ub(x, value) upper_bound(all(x), value)",
      "#define nl '\\n'",
      "",
      "constexpr int MOD = 1'000'000'007;",
      "constexpr int N = 200'005;",
      "constexpr int INF = 1'000'000'000;",
      "constexpr ll LINF = (1LL << 62);",
      "",
      "#ifdef LOCAL",
      "",
      "template <typename T, typename = void>",
      "struct is_iterable : false_type {};",
      "",
      "template <typename T>",
      "struct is_iterable<T, void_t<",
      "    decltype(std::begin(declval<const T&>())),",
      "    decltype(std::end(declval<const T&>()))",
      ">> : true_type {};",
      "",
      "template <typename T>",
      "struct is_pair : false_type {};",
      "",
      "template <typename A, typename B>",
      "struct is_pair<pair<A, B>> : true_type {};",
      "",
      "template <typename T, typename = void>",
      "struct is_streamable : false_type {};",
      "",
      "template <typename T>",
      "struct is_streamable<T, void_t<",
      "    decltype(declval<ostream&>() << declval<const T&>())",
      ">> : true_type {};",
      "",
      "template <typename T, typename = void>",
      "struct is_tuple_like : false_type {};",
      "",
      "template <typename T>",
      "struct is_tuple_like<T, void_t<decltype(tuple_size<T>::value)>> : true_type {};",
      "",
      "template <typename T>",
      "struct is_stack : false_type {};",
      "",
      "template <typename T, typename Container>",
      "struct is_stack<stack<T, Container>> : true_type {};",
      "",
      "template <typename T>",
      "struct is_queue : false_type {};",
      "",
      "template <typename T, typename Container>",
      "struct is_queue<queue<T, Container>> : true_type {};",
      "",
      "template <typename T>",
      "struct is_priority_queue : false_type {};",
      "",
      "template <typename T, typename Container, typename Compare>",
      "struct is_priority_queue<priority_queue<T, Container, Compare>> : true_type {};",
      "",
      "template <typename T>",
      "struct is_optional : false_type {};",
      "",
      "template <typename T>",
      "struct is_optional<optional<T>> : true_type {};",
      "",
      "template <typename T>",
      "struct is_variant : false_type {};",
      "",
      "template <typename... T>",
      "struct is_variant<variant<T...>> : true_type {};",
      "",
      "template <typename T>",
      "void _print(const T& x);",
      "",
      "template <typename Tuple, size_t... I>",
      "void _print_tuple(const Tuple& x, index_sequence<I...>) {",
      "  cerr << '(';",
      "  size_t count = 0;",
      "  ((cerr << (count++ ? \", \" : \"\"), _print(get<I>(x))), ...);",
      "  cerr << ')';",
      "}",
      "",
      "template <typename T>",
      "void _print(const T& x) {",
      "  using Raw = remove_reference_t<T>;",
      "  using U = decay_t<T>;",
      "",
      "  // C-style arrays, including multidimensional arrays.",
      "  if constexpr (is_array_v<Raw>) {",
      "    using Elem = remove_cv_t<remove_extent_t<Raw>>;",
      "",
      "    if constexpr (is_same_v<Elem, char>) {",
      "      constexpr size_t array_size = extent_v<Raw>;",
      "      size_t len = 0;",
      "      while (len < array_size && x[len] != '\\0') ++len;",
      "      cerr << '\"';",
      "      cerr.write(x, static_cast<streamsize>(len));",
      "      cerr << '\"';",
      "    } else {",
      "      cerr << '[';",
      "      bool first = true;",
      "      for (const auto& item : x) {",
      "        if (!first) cerr << \", \";",
      "        first = false;",
      "        _print(item);",
      "      }",
      "      cerr << ']';",
      "    }",
      "  } else if constexpr (is_same_v<U, monostate>) {",
      "    cerr << \"monostate\";",
      "  } else if constexpr (is_same_v<U, bool>) {",
      "    cerr << (x ? \"true\" : \"false\");",
      "  } else if constexpr (is_enum_v<U>) {",
      "    cerr << +static_cast<underlying_type_t<U>>(x);",
      "  } else if constexpr (is_pair<U>::value) {",
      "    cerr << '(';",
      "    _print(x.first);",
      "    cerr << \", \";",
      "    _print(x.second);",
      "    cerr << ')';",
      "  } else if constexpr (is_streamable<U>::value) {",
      "    cerr << x;",
      "  } else if constexpr (is_iterable<U>::value) {",
      "    cerr << '[';",
      "    bool first = true;",
      "    for (const auto& item : x) {",
      "      if (!first) cerr << \", \";",
      "      first = false;",
      "      _print(item);",
      "    }",
      "    cerr << ']';",
      "  } else if constexpr (is_stack<U>::value) {",
      "    auto copy = x;",
      "    cerr << '[';",
      "    bool first = true;",
      "    while (!copy.empty()) {",
      "      if (!first) cerr << \", \";",
      "      first = false;",
      "      _print(copy.top());",
      "      copy.pop();",
      "    }",
      "    cerr << ']';",
      "  } else if constexpr (is_queue<U>::value) {",
      "    auto copy = x;",
      "    cerr << '[';",
      "    bool first = true;",
      "    while (!copy.empty()) {",
      "      if (!first) cerr << \", \";",
      "      first = false;",
      "      _print(copy.front());",
      "      copy.pop();",
      "    }",
      "    cerr << ']';",
      "  } else if constexpr (is_priority_queue<U>::value) {",
      "    auto copy = x;",
      "    cerr << '[';",
      "    bool first = true;",
      "    while (!copy.empty()) {",
      "      if (!first) cerr << \", \";",
      "      first = false;",
      "      _print(copy.top());",
      "      copy.pop();",
      "    }",
      "    cerr << ']';",
      "  } else if constexpr (is_tuple_like<U>::value) {",
      "    _print_tuple(x, make_index_sequence<tuple_size<U>::value>{});",
      "  } else if constexpr (is_optional<U>::value) {",
      "    if (x) {",
      "      cerr << \"optional(\";",
      "      _print(*x);",
      "      cerr << ')';",
      "    } else {",
      "      cerr << \"nullopt\";",
      "    }",
      "  } else if constexpr (is_variant<U>::value) {",
      "    visit([](const auto& value) { _print(value); }, x);",
      "  } else {",
      "    cerr << \"<unprintable>\";",
      "  }",
      "}",
      "",
      "// Supports debug(a, b, c) as well as debug(a).",
      "template <typename T, typename... Args>",
      "void _print_many(const T& first, const Args&... rest) {",
      "  _print(first);",
      "  ((cerr << \", \", _print(rest)), ...);",
      "}",
      "",
      "#define debug(...) do { cerr << \"[\" << #__VA_ARGS__ << \"] = \"; _print_many(__VA_ARGS__); cerr << '\\n'; } while (0)",
      "",
      "#else",
      "",
      "#define debug(...) ((void)0)",
      "",
      "#endif",
      ""
    ],
    "description": "CP macros, STL debugging, type aliases, and constants"
  }
}